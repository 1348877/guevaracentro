# Variables de entorno para desarrollo
VITE_API_URL=http://localhost:3001/api
VITE_APP_NAME=Centro Psicológico Integral Guevara
VITE_APP_VERSION=1.0.0

# Configuración de Hugging Face API
REACT_APP_HUGGING_FACE_API_KEY=your_hugging_face_api_key_here

# Configuración de la aplicación
REACT_APP_API_BASE_URL=http://localhost:3001
REACT_APP_WEBSOCKET_URL=ws://localhost:3001

# Configuración de email (opcional)
REACT_APP_EMAIL_SERVICE_ENABLED=false
REACT_APP_EMAIL_FROM=noreply@centroguevara.com
